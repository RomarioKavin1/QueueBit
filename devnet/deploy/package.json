{
  "name": "queuebit-devnet-deploy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deploys the QueueBit account stack to the local devnet from the forge artifacts (run with bun; standalone, not a workspace package)",
  "scripts": {
    "deploy": "bun run deploy.ts",
    "check": "CHECK_ONLY=1 bun run deploy.ts",
    "deploy:4337": "bun run deploy-4337.ts",
    "check:4337": "CHECK_ONLY=1 bun run deploy-4337.ts",
    "bundler": "bun run bundler.ts",
    "up:4337": "bun run up-4337.ts",
    "smoke:4337": "bun run smoke-4337.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
