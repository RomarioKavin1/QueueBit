{
  "name": "queuebit-devnet-deploy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deploys the QueueBit account stack (LeanAccount, LeanPool registry, Safe migration fixtures) to the devnet from the forge artifacts (run with bun; standalone, not a workspace package)",
  "scripts": {
    "deploy": "bun run deploy.ts",
    "check": "CHECK_ONLY=1 bun run deploy.ts",
    "deploy:public": "ETHREX_URL=https://altmempool.forshtat.com STAKING_REGISTRY=0xd51c04d7a0b01124e84de152f4e56d9eecb22d2f ADDRESSES_FILE=addresses.public.json bun run deploy.ts",
    "check:public": "CHECK_ONLY=1 ETHREX_URL=https://altmempool.forshtat.com STAKING_REGISTRY=0xd51c04d7a0b01124e84de152f4e56d9eecb22d2f ADDRESSES_FILE=addresses.public.json bun run deploy.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
