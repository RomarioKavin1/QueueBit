{
  "name": "@queuebit/extension",
  "version": "0.7.0",
  "private": true,
  "description": "QueueBit browser extension (Chromium MV3): a LeanAccount wallet with a quantum-safe owner key, sessions and moves",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare:types": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "VITE_QUEUEBIT_LOCAL_DEVNET=1 VITE_QUEUEBIT_FAUCET_URL=http://127.0.0.1:8791/faucet wxt build && playwright test --project=e2e",
    "e2e:only": "playwright test --project=e2e",
    "screenshots": "VITE_QUEUEBIT_LOCAL_DEVNET=1 VITE_QUEUEBIT_DESIGN=1 wxt build && playwright test --project=screenshots",
    "icons": "node scripts/render-icons.mjs",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "build:local": "VITE_QUEUEBIT_LOCAL_DEVNET=1 wxt build",
    "test:devnet": "LOCAL_DEVNET=1 VITE_QUEUEBIT_LOCAL_DEVNET=1 vitest run test/devnet",
    "e2e:public": "wxt build && QUEUEBIT_PUBLIC_E2E=1 playwright test --project=public",
    "release:build": "node scripts/release-build.mjs"
  },
  "dependencies": {
    "@queuebit/account": "workspace:*",
    "@queuebit/frames": "workspace:*",
    "@queuebit/groth16": "workspace:*",
    "@queuebit/lean-sphincs": "workspace:*",
    "@queuebit/privacy": "workspace:*",
    "@queuebit/rpc": "workspace:*",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@fatsolutions/privacy-pools-core-circuits": "1.0.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
