{
  "name": "@leaked/extension",
  "version": "0.0.0",
  "private": true,
  "description": "LEAKED browser extension (Chromium MV3): everyday key, provider, onboarding",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare:types": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "wxt build && playwright test --project=e2e",
    "e2e:only": "playwright test --project=e2e",
    "screenshots": "wxt build && playwright test --project=screenshots",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@leaked/rpc": "workspace:*",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
