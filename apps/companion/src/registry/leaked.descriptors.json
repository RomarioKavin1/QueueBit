    "account.vaultSetRecipientMode": {
      "role": "vault",
      "admin": true,
      "intent": "{openClause}{strictClause}",
      "consequence": "{openEffect}{strictEffect}",
      "timing": "tightenNowLoosenWaits",
      "looserWhen": {
        "field": "mode",
        "equals": 0
      },
      "fields": {
        "mode": {
          "format": "enum",
          "labels": {
            "0": "Any address",
            "1": "Approved addresses only"
          }
        }
      },
      "derived": {
        "openClause": {
          "when": {
            "field": "mode",
            "equals": 0
          },
          "template": "Let your everyday key pay any address"
        },
        "strictClause": {
          "when": {
            "field": "mode",
            "equals": 1
          },
          "template": "Only pay approved addresses"
        },
        "openEffect": {
          "when": {
            "field": "mode",
            "equals": 0
          },
          "template": "Everyday payments may go to any address, still within your daily limit and per-payment maximum. This loosens your account, so it waits out the waiting period."
        },
        "strictEffect": {
          "when": {
            "field": "mode",
            "equals": 1
          },
          "template": "Everyday payments may only go to addresses on your allowed list. This tightens your account, so it takes effect now."
        }
      }
    },
