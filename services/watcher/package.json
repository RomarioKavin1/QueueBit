{
  "name": "@leaked/watcher",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable LEAKED watcher: polls logs and frame receipts of registered accounts, raises alerts, delivers them by HMAC-signed webhook, an authenticated SSE stream and ntfy-compatible push. Holds no keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "leaked-watcher": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:live": "LIVE_DEVNET=1 vitest run"
  },
  "dependencies": {
    "@leaked/frames": "workspace:*",
    "@leaked/rpc": "workspace:*",
    "@leaked/watcher-core": "workspace:*",
    "viem": "2.57.16"
  }
}
