pragma solidity 0.8.28;

import {Test, stdStorage, StdStorage} from "forge-std/Test.sol";
import {DepsRegistry} from "../../src/leanpool/DepsRegistry.sol";
import {PQAggregator} from "../../src/leanpool/PQAggregator.sol";
import {C13Verifier} from "../../src/pq/C13Verifier.sol";
import {IPQVerifier} from "../../src/interfaces/IPQVerifier.sol";
import {TxSim} from "../account/TxSim.sol";
import {LeanAccount} from "../../src/account/LeanAccount.sol";
import {KeystoreValidator, IRingRegistry} from "../../src/account/KeystoreValidator.sol";
import {FrameHelperHub} from "../../src/account/FrameOps.sol";
import {ExecMode} from "../../src/account/interfaces.sol";

/// The vectors file: real SPHINCS- C13 signatures over PQAggregator digests (Forge cannot sign C13), generated by
/// services/leanpool-node/test/pin-pq-aggregator.ts with the node's own digest code. The registry, the aggregator and
/// the account sit at the file's fixed addresses, so a digest depends only on the file.
abstract contract PQAggregatorVectors is Test {
    string internal j;
    address internal REGISTRY;
    address internal AGGREGATOR;
    address internal ACCOUNT;
    address internal PAYEE;
    bytes32 internal pkA;
    bytes32 internal pkB;
    bytes32 internal pkC;
    C13Verifier internal verifier;

    function _loadVectors() internal {
        j = vm.readFile(string.concat(vm.projectRoot(), "/test/leanpool/fixtures/pq-aggregator.json"));
        assertEq(vm.parseJsonUint(j, ".chainId"), block.chainid, "vectors are for chain 31337");
        REGISTRY = vm.parseJsonAddress(j, ".registry");
        AGGREGATOR = vm.parseJsonAddress(j, ".aggregator");
        ACCOUNT = vm.parseJsonAddress(j, ".account");
        PAYEE = vm.parseJsonAddress(j, ".payee");
        pkA = vm.parseJsonBytes32(j, ".keys.A");
        pkB = vm.parseJsonBytes32(j, ".keys.B");
        pkC = vm.parseJsonBytes32(j, ".keys.C");
        verifier = new C13Verifier();
        deployCodeTo("DepsRegistry.sol:DepsRegistry", abi.encode(uint256(0.01 ether)), REGISTRY);
    }

    function _deployAggregator(bytes32 pk, uint256 budget) internal returns (PQAggregator agg) {
        deployCodeTo("PQAggregator.sol:PQAggregator", abi.encode(REGISTRY, address(verifier), pk, budget), AGGREGATOR);
        agg = PQAggregator(payable(AGGREGATOR));
    }

    function _sig(string memory v) internal view returns (bytes memory) {
        return vm.parseJsonBytes(j, string.concat(".vectors.", v, ".sig"));
    }

    function _root(string memory v) internal view returns (bytes32) {
        return vm.parseJsonBytes32(j, string.concat(".vectors.", v, ".root"));
    }

    function _count(string memory v) internal view returns (uint16) {
        return uint16(vm.parseJsonUint(j, string.concat(".vectors.", v, ".count")));
    }

    function _wallets(string memory v) internal view returns (address[] memory) {
        return vm.parseJsonAddressArray(j, string.concat(".vectors.", v, ".wallets"));
    }

    function _digest(string memory v) internal view returns (bytes32) {
        return vm.parseJsonBytes32(j, string.concat(".vectors.", v, ".digest"));
    }

    /// Submits a post vector from a gas payer that is not otherwise involved.
    function _post(PQAggregator agg, string memory v) internal returns (uint8) {
        vm.prank(makeAddr("gas payer"));
        return agg.post(_root(v), _count(v), _wallets(v), _sig(v));
    }
}

contract PQAggregatorTest is PQAggregatorVectors {
    using stdStorage for StdStorage;

    uint256 constant BUDGET = 1 << 22;
    PQAggregator agg;
    DepsRegistry reg;

    function setUp() public {
        _loadVectors();
        reg = DepsRegistry(REGISTRY);
        agg = _deployAggregator(pkA, BUDGET);
        agg.bond{value: 0.01 ether}();
    }

    // ------------------------------------------------------------------------------------------- digests -------

    /// The node's TypeScript digests (the vectors) equal the contract's: EIP-712 over chain, contract, registry,
    /// nonce and the operation's fields.
    function test_digestsMatchTheNode() public view {
        assertEq(agg.postDigest(_root("post0"), _count("post0"), _wallets("post0"), 0), _digest("post0"));
        assertEq(agg.postDigest(_root("post1"), _count("post1"), _wallets("post1"), 1), _digest("post1"));
        assertEq(agg.postDigest(_root("pathPost"), 1, _wallets("pathPost"), 0), _digest("pathPost"));
        assertEq(
            agg.attachDigest(_root("attach0"), vm.parseJsonBytes32(j, ".vectors.attach0.proofHash"), 0),
            _digest("attach0")
        );
        assertEq(agg.rotateDigest(pkC, 0), _digest("rotate0"));
        assertEq(agg.withdrawDigest(PAYEE, 0.5 ether, 0), _digest("withdraw0"));
        // and the signatures are real C13 signatures by the named key
        assertTrue(verifier.verify(pkA, _digest("post0"), _sig("post0")));
        assertTrue(verifier.verify(pkB, _digest("post0"), _sig("post0ByB")));
        assertTrue(verifier.verify(pkC, _digest("post1"), _sig("post1ByC")));
    }

    // ---------------------------------------------------------------------------------------------- post -------

    function test_aValidSignaturePostsTheRoot() public {
        (bytes32 root, uint16 count, address[] memory wallets, bytes memory sig) =
            (_root("post0"), _count("post0"), _wallets("post0"), _sig("post0"));
        vm.prank(makeAddr("gas payer"));
        uint256 g = gasleft();
        uint8 ring = agg.post(root, count, wallets, sig);
        g -= gasleft();
        emit log_named_uint("PQAggregator.post gas (execution, 2 wallets, cold registry)", g);
        assertEq(ring, 0);
        address[] memory ws = _wallets("post0");
        for (uint256 i; i < ws.length; ++i) {
            assertEq(reg.rootAt(AGGREGATOR, ws[i], 0), _root("post0"));
            // the gas payer has no namespace of its own
            assertEq(reg.rootAt(makeAddr("gas payer"), ws[i], 0), bytes32(0));
        }
        assertTrue(reg.isPosted(AGGREGATOR, _root("post0")));
        assertEq(agg.postNonce(), 1);
        assertEq(agg.signaturesUsed(), 1);
        // the next post fills the next ring position
        assertEq(_post(agg, "post1"), 1);
        assertEq(reg.rootAt(AGGREGATOR, _wallets("post1")[0], 1), _root("post1"));
    }

    function test_aWrongSignerIsRefused() public {
        vm.expectRevert(PQAggregator.BadSignature.selector);
        _post(agg, "post0ByB");
    }

    function test_aReplayedNonceIsRefused() public {
        _post(agg, "post0");
        vm.expectRevert(PQAggregator.BadSignature.selector);
        _post(agg, "post0");
    }

    function test_anAlteredRootCountOrWalletListIsRefused() public {
        bytes memory sig = _sig("post0");
        bytes32 root = _root("post0");
        uint16 count = _count("post0");
        address[] memory ws = _wallets("post0");

        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(keccak256("another root"), count, ws, sig);
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(root, count + 1, ws, sig);

        address[] memory fewer = new address[](1);
        fewer[0] = ws[0];
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(root, count, fewer, sig);

        address[] memory swapped = new address[](2);
        (swapped[0], swapped[1]) = (ws[1], ws[0]);
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(root, count, swapped, sig);

        address[] memory more = new address[](3);
        (more[0], more[1], more[2]) = (ws[0], ws[1], makeAddr("victim"));
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(root, count, more, sig);

        bytes memory flipped = bytes.concat(sig);
        flipped[100] ^= 0x01;
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(root, count, ws, flipped);
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.post(root, count, ws, "");

        // nothing was posted or counted
        assertEq(agg.postNonce(), 0);
        assertEq(agg.signaturesUsed(), 0);
        _post(agg, "post0");
    }

    function test_anotherChainIsRefused() public {
        vm.chainId(1);
        vm.expectRevert(PQAggregator.BadSignature.selector);
        _post(agg, "post0");
    }

    function test_anotherAggregatorContractIsRefused() public {
        // the same key and registry at another address: the domain names the contract
        PQAggregator other = new PQAggregator(DepsRegistry(REGISTRY), verifier, pkA, BUDGET);
        other.bond{value: 0.01 ether}();
        vm.expectRevert(PQAggregator.BadSignature.selector);
        other.post(_root("post0"), _count("post0"), _wallets("post0"), _sig("post0"));
    }

    function test_anUnbondedAggregatorCannotPost() public {
        vm.store(REGISTRY, keccak256(abi.encode(AGGREGATOR, uint256(0))), bytes32(0)); // bonds[AGGREGATOR] = 0
        assertEq(reg.bonds(AGGREGATOR), 0);
        vm.expectRevert(DepsRegistry.NotBonded.selector);
        _post(agg, "post0");
    }

    // ------------------------------------------------------------------------------------------- attach -------

    function test_attachProofNeedsTheKey() public {
        _post(agg, "post0");
        bytes32 root = _root("attach0");
        bytes32 proofHash = vm.parseJsonBytes32(j, ".vectors.attach0.proofHash");
        bytes memory sig = _sig("attach0");

        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.attachProof(root, keccak256("a forged STARK"), sig);
        // a post signature is not an attach signature (separate typehash)
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.attachProof(root, proofHash, _sig("post0"));

        vm.prank(makeAddr("gas payer"));
        agg.attachProof(root, proofHash, sig);
        (,,, bytes32 attached) = reg.batches(AGGREGATOR, root);
        assertEq(attached, proofHash);
        assertEq(agg.attachNonce(), 1);
        assertEq(agg.postNonce(), 1, "attach has its own nonce lane");
        assertEq(agg.signaturesUsed(), 2);

        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.attachProof(root, proofHash, sig);
        // and nobody else can write the aggregator's proof hash through the registry
        vm.expectRevert(DepsRegistry.NotPoster.selector);
        reg.attachProof(root, keccak256("a forged STARK"));
    }

    // ------------------------------------------------------------------------------------- budget / rotation ---

    function test_postsStopBeforeTheBudgetAndRotationResetsIt() public {
        uint256 reserve = agg.ADMIN_RESERVE();
        agg = _deployAggregator(pkA, reserve + 1); // one post signature, then only admin ones
        assertEq(agg.remainingPostSignatures(), 1);
        _post(agg, "post0");
        assertEq(agg.remainingPostSignatures(), 0);
        vm.expectRevert(PQAggregator.BudgetExhausted.selector);
        _post(agg, "post1");

        // the reserve still lets the old key rotate
        agg.rotateKey(pkC, _sig("rotate0"));
        assertEq(agg.publicKey(), pkC);
        assertEq(agg.signaturesUsed(), 0);
        _post(agg, "post1ByC");
        assertEq(reg.rootAt(AGGREGATOR, _wallets("post1ByC")[0], 1), _root("post1ByC"));
    }

    function test_adminSignaturesStopAtTheBudget() public {
        stdstore.target(AGGREGATOR).sig("signaturesUsed()").checked_write(BUDGET);
        vm.expectRevert(PQAggregator.BudgetExhausted.selector);
        agg.rotateKey(pkC, _sig("rotate0"));
        stdstore.target(AGGREGATOR).sig("signaturesUsed()").checked_write(BUDGET - 1);
        agg.rotateKey(pkC, _sig("rotate0"));
    }

    function test_rotationRetiresTheOldKey() public {
        _post(agg, "post0");
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.rotateKey(pkB, _sig("rotate0")); // signed for pkC
        vm.expectEmit(AGGREGATOR);
        emit PQAggregator.KeyRotated(pkA, pkC, 0);
        agg.rotateKey(pkC, _sig("rotate0"));
        assertEq(agg.adminNonce(), 1);

        vm.expectRevert(PQAggregator.BadSignature.selector);
        _post(agg, "post1"); // the old key, same digest
        _post(agg, "post1ByC");

        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.rotateKey(pkC, _sig("rotate0")); // replay
        vm.expectRevert(PQAggregator.ZeroKey.selector);
        agg.rotateKey(bytes32(0), _sig("rotate0"));
    }

    // ------------------------------------------------------------------------------------- bond / withdraw -----

    function test_bondingIsPermissionlessAndCreditsTheContract() public {
        address anyone = makeAddr("anyone");
        vm.deal(anyone, 1 ether);
        vm.prank(anyone);
        agg.bond{value: 0.02 ether}();
        assertEq(reg.bonds(AGGREGATOR), 0.03 ether);
        assertEq(reg.bonds(anyone), 0);
    }

    function test_withdrawNeedsTheKey() public {
        vm.deal(AGGREGATOR, 1 ether);
        bytes memory sig = _sig("withdraw0");
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.withdraw(payable(makeAddr("thief")), 0.5 ether, sig);
        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.withdraw(payable(PAYEE), 0.6 ether, sig);

        vm.prank(makeAddr("gas payer"));
        agg.withdraw(payable(PAYEE), 0.5 ether, sig);
        assertEq(PAYEE.balance, 0.5 ether);
        assertEq(AGGREGATOR.balance, 0.5 ether);

        vm.expectRevert(PQAggregator.BadSignature.selector);
        agg.withdraw(payable(PAYEE), 0.5 ether, sig);
    }

    // --------------------------------------------------------------------------------------- constructor -------

    function test_constructorChecks() public {
        vm.expectRevert(PQAggregator.ZeroKey.selector);
        new PQAggregator(reg, verifier, bytes32(0), BUDGET);
        vm.expectRevert(PQAggregator.BadBudget.selector);
        new PQAggregator(reg, verifier, pkA, BUDGET + 1);
        vm.expectRevert(PQAggregator.BadBudget.selector);
        new PQAggregator(reg, verifier, pkA, 16);
        assertEq(address(agg.verifier()), address(verifier));
        assertEq(address(agg.registry()), REGISTRY);
        assertEq(agg.signatureBudget(), BUDGET);
    }
}

/// End to end: an owner tx (one PQ key, through LeanPool) is approved by KeystoreValidator when its root was posted
/// by the PQAggregator its policy names, and refused when an ECDSA-keyed aggregator posted it instead.
contract PQAggregatorAccountPathTest is TxSim, PQAggregatorVectors {
    event Approved(uint256 scope);

    bytes32 constant VK = keccak256("vk A");
    bytes32 constant SH = keccak256("the tx SIG_HASH");
    KeystoreValidator ks;
    LeanAccount impl;
    PQAggregator agg;
    bytes lastVerify;

    function setUp() public {
        _loadVectors();
        FrameHelperHub hub = new FrameHelperHub();
        ks = new KeystoreValidator(IRingRegistry(REGISTRY), hub);
        impl = new LeanAccount(hub);
        wireTxSim(address(hub));
        agg = _deployAggregator(pkA, 1 << 22);
        agg.bond{value: 0.01 ether}();

        // The account: an EIP-1167 clone of the implementation at the vectors' address, one PQ key (admin + spend),
        // policy aggregator = the PQAggregator.
        vm.etch(
            ACCOUNT, abi.encodePacked(hex"363d3d373d3d3d363d73", address(impl), hex"5af43d82803e903d91602b57fd5bf3")
        );
        KeystoreValidator.KeyInit[] memory keys = new KeystoreValidator.KeyInit[](1);
        keys[0].kind = 1; // PQ
        keys[0].weight = 1;
        keys[0].roles = 3; // ADMIN | SPEND
        keys[0].a = VK;
        KeystoreValidator.Policy memory p = KeystoreValidator.Policy(1, 1, true, AGGREGATOR);
        LeanAccount acct = LeanAccount(payable(ACCOUNT));
        acct.initialize(address(ks), abi.encode(p, keys), address(0), "", new address[](0), new bytes[](0));
        vm.deal(ACCOUNT, 1 ether);
    }

    /// [VERIFY(account.verify(ks, envelope)), SENDER(account.execute(send 0.1 ETH))], one leanSPHINCS dependency.
    function _ownerTx(bytes32 root, uint8 ring) internal {
        txm.reset(ACCOUNT, SH);
        bytes memory triples = abi.encodePacked(uint256(0x10), bytes32(0), VK);
        lastVerify = abi.encodeCall(
            LeanAccount.verify, (abi.encode(address(ks), abi.encode(ks.LEANPOOL_DEPS(), triples, new uint256[](0))))
        );
        txm.addFrame(1, address(0), 0, lastVerify);
        bytes memory exec = abi.encodeCall(
            LeanAccount.execute,
            (
                ExecMode.encode(ExecMode.CALLTYPE_SINGLE, ExecMode.EXECTYPE_DEFAULT),
                abi.encodePacked(makeAddr("payee"), uint256(0.1 ether), "")
            )
        );
        txm.addFrame(2, address(0), 0, exec);
        txm.addSig(0, address(0), 0, abi.encode(root, ring, new bytes32[][](1)));
    }

    function test_keystoreAcceptsAnOwnerTxWhoseRootThePQAggregatorPosted() public {
        bytes32 root = _root("pathPost");
        assertEq(root, keccak256(abi.encodePacked(uint256(0x10), SH, VK)), "the vectors' root is this tx's leaf");
        vm.prank(makeAddr("gas payer"));
        uint8 ring = agg.post(root, 1, _wallets("pathPost"), _sig("pathPost"));
        _ownerTx(root, ring);
        vm.expectEmit(ACCOUNT);
        emit Approved(3);
        (bool ok,) = ACCOUNT.call(lastVerify);
        assertTrue(ok, "VERIFY approves");
    }

    function test_aRootPostedByAnEcdsaAggregatorIsNotTrusted() public {
        // The same root posted by an ECDSA-keyed aggregator (e.g. the gas payer bonding for itself): the policy names
        // the PQAggregator, so the account never reads that namespace.
        bytes32 root = _root("pathPost");
        address eoa = makeAddr("gas payer");
        vm.deal(eoa, 1 ether);
        vm.startPrank(eoa);
        DepsRegistry(REGISTRY).bond{value: 0.01 ether}();
        uint8 ring = DepsRegistry(REGISTRY).postRoot(root, 1, _wallets("pathPost"));
        vm.stopPrank();
        _ownerTx(root, ring);
        (bool ok, bytes memory err) = ACCOUNT.call(lastVerify);
        assertFalse(ok);
        assertEq(bytes4(err), KeystoreValidator.BadWitness.selector);
    }
}
