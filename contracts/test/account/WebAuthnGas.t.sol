pragma solidity 0.8.28;

import {Test, console} from "forge-std/Test.sol";
import {WebAuthn} from "../../src/account/WebAuthn.sol";

contract WebAuthnHarness {
    function verify(bytes32 c, WebAuthn.Assertion memory a, bytes32 x, bytes32 y) external view returns (bool) {
        return WebAuthn.verify(c, a, x, y);
    }

    function fieldHash(bytes32 c) external pure returns (bytes32) {
        return WebAuthn._challengeFieldHash(c);
    }

    function digest(bytes memory ad, bytes memory cdj) external view returns (bytes32) {
        return WebAuthn._digest(ad, cdj);
    }

    function breakdown(bytes32 c, WebAuthn.Assertion memory a, bytes32 x, bytes32 y)
        external
        view
        returns (uint256[4] memory g)
    {
        uint256 t = gasleft();
        WebAuthn._challengeFieldHash(c);
        g[0] = t - gasleft();
        t = gasleft();
        bytes32 d = WebAuthn._digest(a.authenticatorData, bytes(a.clientDataJSON));
        g[1] = t - gasleft();
        t = gasleft();
        (bool ok,) = address(0x100).staticcall(abi.encode(d, a.r, a.s, x, y));
        g[2] = t - gasleft();
        t = gasleft();
        WebAuthn.verify(c, a, x, y);
        g[3] = t - gasleft();
        require(ok);
    }

    function b64(bytes32 d) external pure returns (string memory) {
        return string(WebAuthn.base64url(d));
    }
}

/// The real vector (generated by ts/account/test/vectors.test.ts) against the real P256VERIFY: correctness of every
/// check, and the gas the passkey path costs inside a 100k VERIFY budget.
contract WebAuthnTest is Test {
    WebAuthnHarness h = new WebAuthnHarness();
    bytes32 challenge;
    bytes32 x;
    bytes32 y;
    WebAuthn.Assertion a;

    function setUp() public {
        string memory json = vm.readFile("test/account/fixtures/webauthn-vector.json");
        challenge = vm.parseJsonBytes32(json, ".challenge");
        x = vm.parseJsonBytes32(json, ".x");
        y = vm.parseJsonBytes32(json, ".y");
        a = WebAuthn.Assertion({
            authenticatorData: vm.parseJsonBytes(json, ".authenticatorData"),
            clientDataJSON: vm.parseJsonString(json, ".clientDataJSON"),
            challengeIndex: vm.parseJsonUint(json, ".challengeIndex"),
            typeIndex: vm.parseJsonUint(json, ".typeIndex"),
            r: vm.parseJsonUint(json, ".r"),
            s: vm.parseJsonUint(json, ".s")
        });
    }

    function test_base64url_matches_webauthn() public view {
        assertEq(h.b64(challenge), "VdMIH_k9mkFwQDIC2tieGoNcFzKqXxh3ogNmtBhz-iQ");
        assertEq(h.b64(bytes32(0)), "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA");
        assertEq(h.b64(bytes32(type(uint256).max)), "__________________________________________8");
    }

    function test_verify_gas_under_budget() public view {
        assertTrue(h.verify(challenge, a, x, y));
        uint256 used = h.breakdown(challenge, a, x, y)[3];
        console.log("WebAuthn.verify gas:", used);
        assertLt(used, 15_000); // P256VERIFY alone is 6,900
    }

    function test_steps() public view {
        assertEq(h.fieldHash(challenge), keccak256(abi.encodePacked('"challenge":"', h.b64(challenge), '"')));
        bytes memory cdj = bytes(a.clientDataJSON);
        assertEq(h.digest(a.authenticatorData, cdj), sha256(abi.encodePacked(a.authenticatorData, sha256(cdj))));
    }

    function test_refusals() public view {
        assertFalse(h.verify(bytes32(uint256(challenge) ^ 1), a, x, y)); // other challenge
        WebAuthn.Assertion memory b = a;
        b.typeIndex = a.typeIndex + 1;
        assertFalse(h.verify(challenge, b, x, y)); // type not where claimed
        b = a;
        b.challengeIndex = 1000;
        assertFalse(h.verify(challenge, b, x, y)); // out of range
        b = a;
        bytes memory ad = bytes.concat(a.authenticatorData);
        ad[32] = 0x04; // user present bit cleared
        b.authenticatorData = ad;
        assertFalse(h.verify(challenge, b, x, y));
        b = a;
        b.s = a.s ^ 1;
        assertFalse(h.verify(challenge, b, x, y)); // bad signature
    }
}
