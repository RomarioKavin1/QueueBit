{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@queuebit/frames": ["../../../packages/frames/src/index.ts"],
      "@queuebit/rpc": ["../../../packages/rpc/src/index.ts"],
      "@queuebit/pq-signer": ["../../../packages/pq-signer/src/index.ts"],
      "@queuebit/lean-sphincs": ["../../../packages/lean-sphincs/src/index.ts"]
    }
  },
  "include": ["*.ts"]
}
