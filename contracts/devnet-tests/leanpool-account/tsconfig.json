{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@queuebit/frames": ["../../../packages/frames/src/index.ts"],
      "@queuebit/rpc": ["../../../packages/rpc/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
