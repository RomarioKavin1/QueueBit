{
  "name": "queuebit-contracts-devnet-tests-leanpool-account",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LeanAccount (ERC-8286 + ERC-7579, post-quantum keystore through LeanPool) on the PUBLIC alt-mempool devnet: SDK, migration rails (migrateEOA, migrateSA), sessions with token caps and MetaMask (EIP-712) keys, guardian recovery; unit tests and live scripts (bun; standalone, not a pnpm workspace package).",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "bun src/account/scripts/deploy.ts",
    "live:sessions": "bun src/account/scripts/sessions-live.ts",
    "live:grants": "bun --conditions=source src/account/scripts/grants-live.ts",
    "live:migrate": "bun src/account/scripts/migrate-live.ts",
    "live:keystore": "bun src/account/scripts/live-keystore.ts",
    "live:recovery": "bun src/account/scripts/recovery-live.ts",
    "live:passkey": "bun src/account/scripts/passkey-live.ts",
    "live:safe": "bun src/account/scripts/safe-migrate-live.ts"
  },
  "dependencies": {
    "@forshtat/hegota-support": "0.0.1",
    "@kevaundray/lean-pq": "0.7.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
