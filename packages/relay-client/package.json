{
  "name": "@queuebit/relay-client",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end encrypted client for the QueueBit relay (phone → browser): one-time channels, AES-GCM with a key that never reaches the server",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0"
  }
}
