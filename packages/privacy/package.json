{
  "name": "@queuebit/privacy",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy Pools v1 integration: Kohaku-compatible Host adapters, the vault EnvelopeSigner over QR, sync/prove/withdraw (0xbow relayer or the PoolPayer frame paymaster)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "LIVE_DEVNET=1 vitest run"
  },
  "dependencies": {
    "@queuebit/frames": "workspace:*",
    "@queuebit/rpc": "workspace:*",
    "@queuebit/ur": "workspace:*",
    "@zk-kit/lean-imt": "2.2.2",
    "poseidon-lite": "0.3.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@fatsolutions/privacy-pools-core-circuits": "1.0.5",
    "snarkjs": "0.7.5"
  }
}
