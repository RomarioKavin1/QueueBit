{
  "name": "@queuebit/account",
  "version": "0.0.0",
  "private": true,
  "description": "LeanAccount SDK: build, sign and send EIP-8141 frame txs (PQ owner via LeanPool, sessions, passkeys, EIP-712 keys) and the migration rails from EOAs, UUPS accounts and Safes",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@queuebit/frames": "workspace:*",
    "@queuebit/rpc": "workspace:*",
    "viem": "2.57.16"
  }
}
