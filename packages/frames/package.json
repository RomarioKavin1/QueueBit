{
  "name": "@queuebit/frames",
  "version": "0.0.0",
  "private": true,
  "description": "Profile-driven EIP-8141 frame-transaction codec: encode, decode, sig hash, signing, builders, receipts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pin-vectors": "vitest run --config vitest.pin.config.ts"
  },
  "dependencies": {
    "viem": "2.57.16"
  }
}
