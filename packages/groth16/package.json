{
  "name": "@queuebit/groth16",
  "version": "0.1.0",
  "private": true,
  "description": "MIT Groth16 (BN254) prover for circom circuits on arkworks/WASM: the default @queuebit/privacy engine (snarkjs-compatible proofs, no GPL code)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "BENCH.md"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:rust": "cd rust && cargo test --release --features native",
    "bench": "node bench/wasm-bench.mjs",
    "bench:native": "bash scripts/bench-native.sh"
  },
  "dependencies": {
    "@queuebit/privacy": "workspace:*"
  },
  "devDependencies": {
    "@fatsolutions/privacy-pools-core-circuits": "1.0.5",
    "@types/node": "26.6.6",
    "snarkjs": "0.7.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
