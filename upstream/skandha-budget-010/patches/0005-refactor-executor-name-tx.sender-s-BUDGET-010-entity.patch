From a3cdd0d8a937c798a76b6769a2934dfb49260cfa Mon Sep 17 00:00:00 2001
From: Romario Kavin <98270892+RomarioKavin1@users.noreply.github.com>
Date: Fri, 6 Nov 2026 03:50:07 +0530
Subject: [PATCH 5/5] refactor(executor): name tx.sender's BUDGET-010 entity
 'sender' in every shape

A Self Relay self_verify frame has prefix role 'payer', but the entity is tx.sender
(sender and payer at once); say so in the rejection reason and the explorer detail.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../UserOpValidation/utils/validationPrefix.ts        | 11 ++++++-----
 .../services/UserOpValidation/utils/budget010.test.ts |  6 +++---
 .../UserOpValidation/validators/frameTx.test.ts       |  4 ++--
 3 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/packages/executor/src/services/UserOpValidation/utils/validationPrefix.ts b/packages/executor/src/services/UserOpValidation/utils/validationPrefix.ts
index faf0013..e199495 100644
--- a/packages/executor/src/services/UserOpValidation/utils/validationPrefix.ts
+++ b/packages/executor/src/services/UserOpValidation/utils/validationPrefix.ts
@@ -352,7 +352,7 @@ export type PrefixEntityRole = ValidationPrefixMatch["frames"][number]["role"];
 export interface EntityVerifyGas {
   /** Checksummed entity address. */
   address: `0x${string}`;
-  /** Every prefix role this address plays (Self Relay: `tx.sender` is the payer). */
+  /** Every prefix role this address plays (Self Relay: `tx.sender` is sender and payer). */
   roles: PrefixEntityRole[];
   /** Absolute `tx.frames` indices attributed to this entity. */
   frameIndices: number[];
@@ -402,7 +402,10 @@ export function computeEntityVerifyGas(
   const entry = (address: `0x${string}`): EntityVerifyGas => {
     let e = byAddress.get(address);
     if (!e) {
-      e = { address, roles: [], frameIndices: [], execution: BigInt(0), signatureCost: BigInt(0), total: BigInt(0) };
+      // tx.sender is always the sender entity, whichever role its frame has
+      // (Self Relay: its self_verify frame is the payer's).
+      const roles: PrefixEntityRole[] = address === senderAddr ? ["sender"] : [];
+      e = { address, roles, frameIndices: [], execution: BigInt(0), signatureCost: BigInt(0), total: BigInt(0) };
       byAddress.set(address, e);
     }
     return e;
@@ -420,9 +423,7 @@ export function computeEntityVerifyGas(
 
   const sigCost = signatureVerificationCost(tx);
   if (sigCost > BigInt(0)) {
-    const e = entry(senderAddr);
-    if (e.roles.length === 0) e.roles.push("sender");
-    e.signatureCost += sigCost;
+    entry(senderAddr).signatureCost += sigCost;
   }
   for (const e of byAddress.values()) e.total = e.execution + e.signatureCost;
 
diff --git a/packages/executor/test/services/UserOpValidation/utils/budget010.test.ts b/packages/executor/test/services/UserOpValidation/utils/budget010.test.ts
index 2542276..2a12615 100644
--- a/packages/executor/test/services/UserOpValidation/utils/budget010.test.ts
+++ b/packages/executor/test/services/UserOpValidation/utils/budget010.test.ts
@@ -95,7 +95,7 @@ describe("computeEntityVerifyGas (BUDGET-010 attribution)", () => {
     expect(u.entities).toHaveLength(1);
     expect(u.entities[0]).toMatchObject({
       address: SENDER,
-      roles: ["payer"],
+      roles: ["sender", "payer"],
       frameIndices: [0],
       execution: 150_000n,
       signatureCost: 2_800n,
@@ -131,7 +131,7 @@ describe("computeEntityVerifyGas (BUDGET-010 attribution)", () => {
     const u = usageOf(tx([defaultFrame(200_000n, FACTORY), selfVerify(20_000n), body()]));
     expect(u.entities.map((e) => [e.address, e.roles, e.total])).toEqual([
       [FACTORY, ["factory"], 200_000n],
-      [SENDER, ["payer"], 20_000n],
+      [SENDER, ["sender", "payer"], 20_000n],
     ]);
   });
 
@@ -170,7 +170,7 @@ describe("checkVerifyGasBudgets (BUDGET-010 limits)", () => {
   it("admits the same prefix when the entity is staked", async () => {
     const isStaked = stakedSet(SENDER);
     const r = await checkVerifyGasBudgets(usageOf(tx([selfVerify(150_000n), body()], [sig(SIG_SCHEME.SECP256K1)])), isStaked);
-    expect(r).toEqual({ valid: true, summary: "payer 152800/1000000 (staked)" });
+    expect(r).toEqual({ valid: true, summary: "sender+payer 152800/1000000 (staked)" });
     expect(isStaked).toHaveBeenCalledWith(SENDER);
   });
 
diff --git a/packages/executor/test/services/UserOpValidation/validators/frameTx.test.ts b/packages/executor/test/services/UserOpValidation/validators/frameTx.test.ts
index 7f30415..37098d1 100644
--- a/packages/executor/test/services/UserOpValidation/validators/frameTx.test.ts
+++ b/packages/executor/test/services/UserOpValidation/validators/frameTx.test.ts
@@ -1238,7 +1238,7 @@ describe("FrameTxValidationService: ERC-8421 BUDGET-010 per-entity budgets", ()
   it("rejects an unstaked sender's 150k VERIFY under rule BUDGET-010, before simulation results are consulted", async () => {
     const collector = new CheckCollector();
     await expect(run(make(), 150_000n, collector)).rejects.toThrow(
-      /BUDGET-010: payer 0x1111111111111111111111111111111111111111 verification gas 150000 .* exceeds MAX_VERIFY_GAS_PER_ENTITY 100000 for an unstaked entity/
+      /BUDGET-010: sender\+payer 0x1111111111111111111111111111111111111111 verification gas 150000 .* exceeds MAX_VERIFY_GAS_PER_ENTITY 100000 for an unstaked entity/
     );
     const checks = collector.toChecks();
     expect(checks.find((c) => c.rule === "BUDGET-010")).toMatchObject({ verdict: "fail" });
@@ -1252,7 +1252,7 @@ describe("FrameTxValidationService: ERC-8421 BUDGET-010 per-entity budgets", ()
     });
     expect(collector.toChecks().find((c) => c.rule === "BUDGET-010")).toMatchObject({
       verdict: "pass",
-      detail: "payer 150000/1000000 (staked)",
+      detail: "sender+payer 150000/1000000 (staked)",
     });
   });
 
-- 
